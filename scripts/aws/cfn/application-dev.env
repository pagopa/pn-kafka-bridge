# Bootstrap servers for the Kafka brokers used by the payment events consumer
PN_KAFKA_BRIDGE_PAYMENT_EVENTS_BOOTSTRAP_SERVERS=10.1.41.75:9092
# Kafka topic receiving payment-related events
PN_KAFKA_BRIDGE_PAYMENT_EVENTS_TOPIC_NAME=payment_events
# Consumer group used to process payment events from the topic
PN_KAFKA_BRIDGE_PAYMENT_EVENTS_GROUP_ID=pn-payments-local
# Security protocol used by the Kafka client for payment events
PN_KAFKA_BRIDGE_PAYMENT_EVENTS_PROPERTIES_SECURITY_PROTOCOL=PLAINTEXT
# SASL mechanism configured for Kafka authentication, if required by the broker
PN_KAFKA_BRIDGE_PAYMENT_EVENTS_PROPERTIES_SASL_MECHANISM=PLAIN
# Maximum number of records fetched per poll for payment events processing
PN_KAFKA_BRIDGE_PAYMENT_EVENTS_PROPERTIES_MAX_POLL_RECORDS=10
# Minimum bytes to fetch before returning a response for payment event records
PN_KAFKA_BRIDGE_PAYMENT_EVENTS_PROPERTIES_FETCH_MIN_BYTES=256000
# Maximum time to wait before fetching payment event records
PN_KAFKA_BRIDGE_PAYMENT_EVENTS_PROPERTIES_FETCH_MAX_WAIT_MS=60000
# Number of consumer threads used to process payment events
PN_KAFKA_BRIDGE_PAYMENT_EVENTS_CONCURRENCY=16
# Cron expression for the payment-events metrics collection job
PN_KAFKA_BRIDGE_METRICS_PAYMENTS_EVENTS_CRON=0 */5 * * * *